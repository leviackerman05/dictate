---
interface Props {
  size?: number;
}

const { size = 30 } = Astro.props;
const width = Math.round(size * 1.3);
const height = Math.round(size * 0.58);
---
<svg class="brand-logo" width={width} height={height} viewBox="0 0 336 144" role="img" aria-label="Dictate">
  <path d="M19 72C39 97 64 96 84 64C104 32 130 34 151 72C172 110 197 108 217 72C237 36 258 36 270 69" fill="none" stroke="currentColor" stroke-width="24" stroke-linecap="round" stroke-linejoin="round" />
  <circle cx="312" cy="72" r="22" fill="currentColor" />
</svg>

<style>
  .brand-logo { display: block; flex: 0 0 auto; color: var(--text); overflow: visible; }
</style>
